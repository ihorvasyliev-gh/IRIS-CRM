{
  "manifest_version": 3,
  "name": "CRM → IRIS",
  "version": "0.4.0",
  "description": "Find a student in the CCP CRM and fill IRIS (SICAP) New Individual and Individual Intervention forms.",
  "action": {
    "default_title": "CRM → IRIS"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.dynamics.com/*",
    "https://*.autoaddress.ie/*",
    "https://*.autoaddress.com/*",
    "https://*.supabase.co/*",
    "wss://*.supabase.co/*"
  ]
}
